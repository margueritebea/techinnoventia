# ============================================================================
# MODE DEBUG
# ============================================================================
DEBUG=True

# ============================================================================
# CLÉS SECRÈTES
# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ============================================================================
SECRET_KEY=changeme!

# ============================================================================
# HOSTS AUTORISÉS (séparés par des virgules)
# ============================================================================
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================================
# BASE DE DONNÉES
# Dev  : laisser vide → SQLite par défaut
# Prod : postgres://USER:PASSWORD@HOST:PORT/DB_NAME
# ============================================================================
DATABASE_URL=postgres://postgres:password@localhost:5432/tech_innoventia_db

# ============================================================================
# JWT
# ============================================================================
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30

# ============================================================================
# DRF THROTTLE (requêtes/heure)
# ============================================================================
DRF_THROTTLE_ANON=100
DRF_THROTTLE_USER=1000

# ============================================================================
# EMAIL
# ============================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=changeme@gmail.com
EMAIL_HOST_PASSWORD=changeme
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=webmaster@localhost

# ============================================================================
# CORS (origines autorisées, séparées par des virgules)
# ============================================================================
CORS_ALLOWED_ORIGINS=https://ton-domaine.com,https://www.ton-domaine.com

# ============================================================================
# WEBSOCKET / CHANNELS
# Laisser vide → InMemoryChannelLayer (dev)
# Prod : redis://localhost:6379/0
# ============================================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# MODÈLES LLM LOCAUX (ia_chat)
# Chemin vers les fichiers .gguf sur la machine
# Télécharger depuis HuggingFace (voir README pour les liens)
# ============================================================================
LLAMA3_MODEL_PATH=/opt/kgm_models/Llama-3.2-3B-Instruct-Q4_K_M.gguf
MISTRAL_MODEL_PATH=/opt/kgm_models/Mistral-Nemo-Instruct-2407.Q5_K_M.gguf
QWEN_MODEL_PATH=/opt/kgm_models/Qwen2-VL-7B-Instruct-Q2_K.gguf

# Paramètres LLM globaux
LLM_N_THREADS=4             # Nombre de threads CPU pour l'inférence
LLM_N_GPU_LAYERS=0          # Couches GPU (0 = CPU uniquement, -1 = tout sur GPU)
LLM_CONTEXT_SIZE=2048       # Taille du contexte (tokens)
